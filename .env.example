# Where lead-form submissions are POSTed as JSON (CRM, Slack or email webhook).
# Leave empty in development: leads are then only logged by the server.
LEAD_WEBHOOK_URL=

# Public address of the site, used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=

# Plausible analytics domain. Leave empty to load no analytics script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# PostHog project key (public, starts with phc_) and region host. Leave the key empty to send nothing.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
